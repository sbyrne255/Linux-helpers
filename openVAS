sudo bash -c '
export DEBIAN_FRONTEND=noninteractive;
wget -O /usr/share/keyrings/kali-archive-keyring.gpg https://archive.kali.org/archive-keyring.gpg;
apt install --reinstall kali-archive-keyring;
apt clean;
apt update -y;
apt -y full-upgrade;

set -e

apt update
apt install -y openvas

gvm-setup
gvm-check-setup

systemctl enable gvmd gsad ospd-openvas
systemctl start gvmd gsad ospd-openvas

gvm-feed-update
systemctl restart gvmd

# Install cron jobs (boot + daily)
(
  crontab -l 2>/dev/null
  echo "@reboot sleep 300 && /usr/sbin/gvm-feed-update >> /var/log/gvm-feed.log 2>&1"
  echo "0 3 * * * /usr/sbin/gvm-feed-update >> /var/log/gvm-feed.log 2>&1"
) | sudo crontab -

read -s -p "Enter new admin password: " GVM_PASS

gvmd --user=admin --new-password="$GVM_PASS"
'
